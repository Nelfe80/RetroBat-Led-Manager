<Window x:Class="LedManager.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LedManager Setup — Panel virtuel"
        Width="960" Height="560"
        Background="{StaticResource AppBackground}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#D04040" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <TextBlock x:Name="StatusText" Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource AppMuted}" Text="En attente de LedManager (127.0.0.1:12377)…"/>
            <TextBlock Text="PANEL VIRTUEL" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource AppForeground}" FontWeight="Bold" FontSize="16" DockPanel.Dock="Right"/>
        </DockPanel>

        <!-- Panel -->
        <Border Grid.Row="1" Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <UniformGrid x:Name="ButtonsGrid" Rows="2" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="MatrixText" Margin="0,20,0,0" HorizontalAlignment="Center"
                               FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                               Foreground="#30E850" Text=""/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                    <ContentControl x:Name="StartButtonHost"/>
                    <ContentControl x:Name="SelectButtonHost" Margin="0,16,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Log -->
        <ListBox x:Name="LogList" Grid.Row="2" Height="120" Margin="0,12,0,0"
                 Background="#101018" Foreground="{StaticResource AppMuted}"
                 FontFamily="Consolas" FontSize="11" BorderThickness="0"/>
    </Grid>
</Window>
