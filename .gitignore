# IDE/cache
.vs/
.cache/
__pycache__/
**/__pycache__/
*.pyc
*.user
*.suo

# Local tools are installed outside Git; keep only the installation note.
tools/**
!tools/
!tools/README.txt
!tools/**/
!tools/**/README.txt

# Product specs / cahiers des charges stay local.
CAHIER_DES_CHARGES*
*CDC*

# Docs: keep only images and PDFs.
docs/**
!docs/**/
!docs/**/*.pdf
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg
!docs/**/*.gif
!docs/**/*.webp
!docs/**/*.bmp
!docs/**/*.svg
!docs/**/*.ico

# Legacy/manual snapshots
.archive/
**/.archive/
.versioning/

# Build outputs
bin/
obj/
src/**/bin/
src/**/obj/
src/**/.vs/
src/**/.idea/
src/**/TestResults/
src/**/coverage/
src/**/*.user
src/**/*.suo
src/**/*.pdb
src/**/*.cache
src/**/GeneratedFiles/
artifacts/

# Runtime state/logs
.log/
.logs/
.temp/
logs/
state/
*.log
*.jsonl

# Local/archive scratch areas
archv/
OLD_lip/

# Root runtime binaries (shipped via GitHub Releases, not source control)
/LedManager.exe
/PicoCommandSender.exe
/LedManagerSetup.exe

# MkDocs build output
site/

# User panel overrides stay local (only the README ships with the repo)
overrides/**
!overrides/
!overrides/README.txt

