<Window x:Class="LedManager.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LedManager Setup"
        Width="1000" Height="600"
        Background="{StaticResource AppBackground}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#12121A">
            <StackPanel Margin="18,22,18,18">
                <TextBlock Text="LedManager" Foreground="{StaticResource AppForeground}" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="SETUP" Foreground="#8A2BE2" FontSize="12" FontWeight="Bold" Margin="0,0,0,24"/>

                <RadioButton x:Name="NavMonitor" Content="Panel virtuel" GroupName="nav" IsChecked="True"
                             Margin="0,4" Foreground="{StaticResource AppForeground}" FontSize="14"
                             Checked="NavMonitor_Checked"/>
                <RadioButton x:Name="NavWizard" Content="Assistant matériel" GroupName="nav"
                             Margin="0,4" Foreground="{StaticResource AppForeground}" FontSize="14"
                             Checked="NavWizard_Checked"/>

                <TextBlock x:Name="HardwareInfo" Margin="0,28,0,0" Foreground="{StaticResource AppMuted}"
                           FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ContentControl x:Name="ContentHost" Grid.Column="1"/>
    </Grid>
</Window>
